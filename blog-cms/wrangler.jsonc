{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forward-blog-cms",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  // Pinned to the Cloudflare account that owns forwardmy.org, so a
  // `wrangler deploy` from a machine with access to multiple accounts
  // can't accidentally create a duplicate deployment under the wrong
  // one (which is exactly what happened once during initial setup).
  "account_id": "adb1b312e1776686e17ad432f5d11b24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forward_blog",
      "database_id": "88d49007-f89f-4a5e-b166-5d6d4d033485"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "forward-blog-images"
    }
  ]
}
